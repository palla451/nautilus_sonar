# =========================
# Nautilus Sonar
# =========================

# Network interface monitored by Suricata
# Example: ens160, enp0s5, eth0, wlp0s20f3
INTERFACE=wlp0s20f3

# Sensor name displayed in events
SENSOR_NAME=nautilus-sonar

# Optional hostname override
HOSTNAME_OVERRIDE=

# =========================
# Suricata
# =========================

# Suricata EVE JSON log file
SURICATA_EVE_FILE=/var/log/suricata/eve.json

# Suricata rules generated from Laravel
SURICATA_RULES_FILE=/var/lib/suricata/rules/nautilus.rules

# Suricata main configuration
SURICATA_CONFIG_FILE=/etc/suricata/suricata.yaml

# Reload command executed after rule sync
SURICATA_RELOAD_COMMAND=suricatasc -c reload-rules

# =========================
# Rule Synchronization
# =========================

# Enable centralized rule synchronization
RULES_SYNC_ENABLED=true

# Rule sync interval (seconds)
RULES_SYNC_INTERVAL_SECONDS=60

# Laravel Backend API
RULES_BACKEND_URL=http://host.docker.internal:8080/api

# Local rule cache
RULES_CACHE_FILE=/app/output/rules_cache.json

# Local rules directory
CORRELATOR_RULES_DIR=/app/rules

# =========================
# NMEA
# =========================

# Enable NMEA collection
NMEA_ENABLED=true

# NMEA multicast configuration
NMEA_MULTICAST_IP=239.0.1.1
NMEA_PORT=10110

# =========================
# Local Output
# =========================

# Local event archive directory
OUTPUT_DIR=./output

# Local event archive file
OUTPUT_FILE=events.jsonl

# Output rotation settings
OUTPUT_MAX_FILE_SIZE_MB=10
OUTPUT_MAX_FILE_AGE_HOURS=24

# Store raw events locally
RAW_EVENT_ENABLED=false

# =========================
# HTTP Backend (legacy)
# =========================

# Enable direct HTTP ingestion
BACKEND_ENABLED=false

BACKEND_URL=http://backend.local/api/events
BEARER_TOKEN=test-token
BACKEND_BATCH_SIZE=100

# =========================
# Local Buffer
# =========================

# Offline event buffer
BUFFER_DIR=./output/buffer

BUFFER_MAX_MB=100
BUFFER_MAX_HOURS=24

# =========================
# ValKey Streams
# =========================

# Internal message bus
VALKEY_URL=redis://valkey:6379

VALKEY_STREAM=nautilus-stream
VALKEY_DEAD_LETTER_STREAM=nautilus-dead-letter-stream

VALKEY_GROUP=sonar-group
VALKEY_CONSUMER=consumer-1

VALKEY_READ_BLOCK_MS=5000
VALKEY_PENDING_IDLE_MS=60000
VALKEY_PENDING_COUNT=10

# =========================
# OpenSearch
# =========================

# OpenSearch endpoint
OPENSEARCH_ENABLED=true
OPENSEARCH_URL=http://opensearch:9200

# Event index
OPENSEARCH_INDEX=nautilus-events

OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CHANGE_ME

OPENSEARCH_BATCH_SIZE=100

# =========================
# Detection Engine
# =========================

# Laravel API used by nautilus-correlator
CORRELATOR_RULES_BACKEND_URL=http://host.docker.internal:8080/api

# Probe UUID file
CORRELATOR_PROBE_ID_FILE=/app/output/probe_id

# Aggregation / Correlation rule cache
CORRELATOR_RULES_CACHE_FILE=/app/output/correlator_rules_cache.json

# Rule sync interval (seconds)
CORRELATOR_RULES_SYNC_INTERVAL_SECONDS=10