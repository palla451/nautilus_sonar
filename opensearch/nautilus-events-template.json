{
  "index_patterns": ["nautilus-events*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "timestamp": {
          "type": "date"
        },

        "event_type": {
          "type": "keyword"
        },

        "in_iface": {
          "type": "keyword"
        },

        "flow_id": {
          "type": "long"
        },

        "src_ip": {
          "type": "ip"
        },

        "src_port": {
          "type": "integer"
        },

        "dest_ip": {
          "type": "ip"
        },

        "dest_port": {
          "type": "integer"
        },

        "proto": {
          "type": "keyword"
        },

        "app_proto": {
          "type": "keyword"
        },

        "probe": {
          "properties": {
            "probe_id": {
              "type": "keyword"
            },

            "sensor_name": {
              "type": "keyword"
            },

            "host": {
              "properties": {
                "hostname": {
                  "type": "keyword"
                },

                "ip": {
                  "type": "ip"
                },

                "os": {
                  "type": "keyword"
                }
              }
            }
          }
        },

        "payload": {
          "properties": {

            "kind": {
              "type": "keyword"
            },

            "signature_id": {
              "type": "long"
            },

            "signature": {
              "type": "text"
            },

            "category": {
              "type": "keyword"
            },

            "severity": {
              "type": "integer"
            },

            "query": {
              "type": "keyword"
            },

            "query_type": {
              "type": "keyword"
            },

            "hostname": {
              "type": "keyword"
            },

            "url": {
              "type": "text"
            },

            "http_method": {
              "type": "keyword"
            },

            "protocol": {
              "type": "keyword"
            },

            "status": {
              "type": "integer"
            },

            "state": {
              "type": "keyword"
            },

            "reason": {
              "type": "keyword"
            },

            "bytes_toclient": {
              "type": "long"
            },

            "bytes_toserver": {
              "type": "long"
            },

            "pkts_toclient": {
              "type": "long"
            },

            "pkts_toserver": {
              "type": "long"
            }
          }
        }
      }
    }
  }
}